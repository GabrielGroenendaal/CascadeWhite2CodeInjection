	JumpIfTargetIsAlly(&endScript_1)
	GetMove()
	JumpIfStoredIsNotInList(&substituteBlockedMoves, &NewAILogic)
	JumpIfHasSubstitute(defender, &deprioritize_address)

NewAILogic:
	JumpIfStoredIsInList(&setup_moves, &setup_moves_script)
	JumpIfStoredIsInList(&setup_moves_speed, &setup_moves_script)
	JumpIfStoredIsInList(&debuff_moves, &debuff_moves_script)
	JumpIfStoredIsInList(&debuff_moves_save, &debuff_moves_save_script)
	JumpIfStoredIsInList(&debuff_moves_status, &debuff_moves_status_script)
	JumpIfMoveEffectEQ(move_ef.increased_priority, &address_Priority)

endScript_1:
	EndScript()









// SETUP MOVES LOGIC
// Checks to see if the user will faint from the opposing pokemon. If the 
// user is slower and gets 2HKOd, also likely to deprioritize. 
// If the move boosts speed, more likely to go for it if slower.
setup_moves_script:
	JumpIfUserWillFaint_Setup(&deprioritize_address)
	JumpIfUserWillTakeLowDamage_Setup(&high_chance_to_prioritize)
	EndScript()






// DEBUFF MOVES
debuff_moves_script:
	JumpIfUserWillFaint_Setup(&high_chance_to_deprioritize)
	JumpIfUserWillTakeLowDamage_Debuffs(&high_chance_to_deprioritize)
	EndScript()





// DEBUFF MOVES THAT ARE WAY WORSE IF SLOWER 
debuff_moves_save_script:
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.prankster, &EndOfScriptEnd)
	JumpCompareSpeed(GT, &debuff_compareSpeed)
	JumpIfRandLT(102, &debuff_compareSpeed)
	AddToScore(-2)

debuff_compareSpeed:
	JumpIfUserWillTakeLowDamage_Debuffs(&high_chance_to_deprioritize)
	EndScript()







// DEBUFF MOVES THAT ARE WAY WORSE IF SLOWER 
debuff_moves_status_script:
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.prankster, &EndOfScriptEnd)
	JumpCompareSpeed(GT, &EndOfScriptEnd)
	JumpIfRandLT(102, &EndOfScriptEnd)
	AddToScore(-2)
	EndScript()







// PRIORITY 
address_Priority:
	JumpIfUserWillFaint_Priority(&priorityCheckSpeed)
	EndScript()

priorityCheckSpeed:
	JumpIfUserIsSlowerThanAllEnemies(&priorityPrioritize)
	EndScript()

priorityPrioritize:
	JumpIfRandGT(39, &EndOfScriptEnd)
	AddToScore(10)
	EndScript()







// HELPERS
high_chance_to_deprioritize:
	JumpIfRandLT(204, &EndOfScriptEnd)
	AddToScore(-2)
	EndScript()

high_chance_to_prioritize:
	JumpIfRandLT(128, &EndOfScriptEnd)
	AddToScore(2)
	EndScript()

deprioritize_address:
	AddToScore(-10)
	EndScript()

EndOfScriptEnd:
	EndScript()

