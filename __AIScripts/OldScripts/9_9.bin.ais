	JumpIfTargetIsAlly(&address_0x0098)
	GetTurnCount()
	JumpIfStoredNE(0, &address_0x0098)
	JumpIfMoveEffectEQ(move_ef.sunny_day, &address_0x003A)
	JumpIfMoveEffectEQ(move_ef.rain_dance, &address_0x004C)
	JumpIfMoveEffectEQ(move_ef.sandstorm, &address_0x005E)
	JumpIfMoveEffectEQ(move_ef.hail, &address_0x0070)

address_0x003A:
	GetWeather()
	JumpIfStoredEQ(weather.sun, &address_0x0098)
	Jump(&address_0x0082)

address_0x004C:
	GetWeather()
	JumpIfStoredEQ(weather.rain, &address_0x0098)
	Jump(&address_0x0082)

address_0x005E:
	GetWeather()
	JumpIfStoredEQ(weather.sand, &address_0x0098)
	Jump(&address_0x0082)

address_0x0070:
	GetWeather()
	JumpIfStoredEQ(weather.hail, &address_0x0098)
	Jump(&address_0x0082)

address_0x0082:
	StoreIsFirstTurn(attacker)
	JumpIfStoredEQ(false, &address_0x0098)
	AddToScore(5)

address_0x0098:
	EndScript()

	0x0000 [0]
