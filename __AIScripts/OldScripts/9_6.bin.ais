	JumpIfStatStageGT(attacker, atk, +1, &address_0x019A)
	JumpIfStatStageGT(attacker, atk, +0, &address_0x0192)
	JumpIfStatStageGT(attacker, spa, +2, &address_0x01A2)
	JumpIfStatStageGT(attacker, spa, +1, &address_0x019A)
	JumpIfStatStageGT(attacker, spa, +0, &address_0x0192)
	EndScript()


