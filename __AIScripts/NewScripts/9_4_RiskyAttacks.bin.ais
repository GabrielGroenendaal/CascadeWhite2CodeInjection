	CalcMoveDamage(false)
	JumpIfStoredNE(no_damage, &address_0x0052)
	JumpIfHealthGT(defender, 50, &address_0x0064)
	JumpIfRandLT(128, &address_0x002E)
	AddToScore(1)

address_0x002E:
	JumpIfHealthGT(defender, 25, &address_0x0064)
	JumpIfRandLT(128, &address_0x0064)
	AddToScore(1)
	Jump(&address_0x0064)

address_0x0052:
	GetTurnCount()
	JumpIfStoredNE(0, &address_0x0064)
	AddToScore(1)

address_0x0064:
	EndScript()

