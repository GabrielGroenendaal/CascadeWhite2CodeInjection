	JumpIfTargetIsAlly(&address_0x0022)
	GetMoveEffect()
	JumpIfStoredIsNotInList(&data_address_0x0024, &address_0x0022)
	JumpIfRandLT(128, &address_0x0022)
	AddToScore(2)

address_0x0022:
	EndScript()


