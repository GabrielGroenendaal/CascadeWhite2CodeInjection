	JumpIfStoredEQ(ability.well_baked_body, &checkFireImmunnity)
	JumpIfStoredEQ(ability.wonder_guard, &checkWonderGuard)
	JumpIfStoredEQ(ability.levitate, &checkGroundImmunity)
	JumpIfStoredEQ(ability.dry_skin, &checkWaterImmunity2)
	JumpIfStoredEQ(ability.sap_sipper, &checkGrassImmunity)
	Jump(&checkPowderImmunity)

checkElectricImmunity:
	GetType(move_type)
	JumpIfStoredEQ(type.electric, &deprioritizeBy12)
	Jump(&checkPowderImmunity)

checkWaterImmunity1:
	GetType(move_type)
	JumpIfStoredEQ(type.water, &deprioritizeBy12)
	Jump(&checkPowderImmunity)

checkFireImmunnity:
	GetType(move_type)
	JumpIfStoredEQ(type.fire, &deprioritizeBy12)
	Jump(&checkPowderImmunity)

checkWonderGuard:
	JumpIfEffectivenessEQ(2x, &checkPowderImmunity)
	JumpIfEffectivenessEQ(4x, &checkPowderImmunity)
	Jump(&deprioritizeBy12)

checkGroundImmunity:
	GetType(move_type)
	JumpIfStoredEQ(type.ground, &deprioritizeBy12)
	Jump(&checkPowderImmunity)

checkWaterImmunity2:
	GetType(move_type)
	JumpIfStoredEQ(type.water, &deprioritizeBy12)
	Jump(&checkPowderImmunity)

checkGrassImmunity:
	GetType(move_type)
	JumpIfStoredEQ(type.grass, &deprioritizeBy12)
	Jump(&checkPowderImmunity)

checkPowderImmunity:
	GetAbilityGuess(defender)
	JumpIfStoredNE(ability.overcoat, &checkPowderImmunity2)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &moveOnToMoveEffects)
	JumpIfMoveEQ(move.sleep_powder, &deprioritizeBy10)
	JumpIfMoveEQ(move.poison_powder, &deprioritizeBy10)
