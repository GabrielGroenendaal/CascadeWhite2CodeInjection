	JumpIfTargetIsAlly(&address_0x0756)
	CalcMoveDamage(false)
	JumpIfStoredEQ(no_damage, &checkPowderImmunity)

address_0x002A:
	JumpIfEffectivenessEQ(0x, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &checkPowderImmunity)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.volt_absorb, &checkElectricImmunity)
	JumpIfStoredEQ(ability.motor_drive, &checkElectricImmunity)
	JumpIfStoredEQ(ability.lightning_rod, &checkElectricImmunity)
	JumpIfStoredEQ(ability.thunder_armor, &checkElectricImmunity)
	JumpIfStoredEQ(ability.water_absorb, &checkWaterImmunity1)
	JumpIfStoredEQ(ability.storm_drain, &checkWaterImmunity1)
