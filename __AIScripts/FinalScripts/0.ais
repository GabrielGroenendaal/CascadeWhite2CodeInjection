//   PSYCHO SHIFT   

Label_PsychoShift:
	JumpIfHasNoStatus(attacker, &deprioritizeBy10)
	JumpIfHasAnyStatus(defender, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &Label_PsychoShiftStatusChecks)
	JumpIfStoredEQ(ability.turboblaze, &Label_PsychoShiftStatusChecks)
	JumpIfStoredEQ(ability.teravolt, &Label_PsychoShiftStatusChecks)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &Label_PsychoShiftStatusChecks)
	JumpIfStoredNE(item.tera_drill, &Label_PsychoShiftStatusChecks)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_bounce, &deprioritizeBy10)

Label_PsychoShiftStatusChecks:
	JumpIfHasSideCondition(defender, side_cond.safeguard, &deprioritizeBy10)
	JumpIfHasSideCondition(defender, side_cond.mist, &deprioritizeBy10)
	JumpIfHasCondition(attacker, cond.poison, &Label_PsychoShiftPoison)
	JumpIfBadlyPoisoned(attacker, &Label_PsychoShiftPoison)
	JumpIfHasCondition(attacker, cond.burn, &Label_PsychoShiftBurn)
	JumpIfHasCondition(attacker, cond.paralysis, &Label_PsychoShiftParalysis)
	Jump(&endScript_26)

Label_PsychoShiftPoison:
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.poison_heal, &deprioritizeBy10)
	GetType(defender_type1)
	JumpIfStoredEQ(type.poison, &deprioritizeBy10)
	JumpIfStoredEQ(type.steel, &deprioritizeBy10)
	GetType(defender_type2)
	JumpIfStoredEQ(type.poison, &deprioritizeBy10)
	JumpIfStoredEQ(type.steel, &deprioritizeBy10)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.toxic_boost, &deprioritizeBy10)
	JumpIfStoredEQ(ability.poison_heal, &deprioritizeBy10)
	JumpIfStoredEQ(ability.magic_guard, &deprioritizeBy10)
	JumpIfHeldItemEQ(defender, item.lum_berry, &HighChanceToDeprioritizeBy10)
	JumpIfHeldItemEQ(defender, item.pecha_berry, &HighChanceToDeprioritizeBy10)
	Jump(&endScript_26)

Label_PsychoShiftBurn:
	GetType(defender_type1)
	JumpIfStoredEQ(type.fire, &deprioritizeBy10)
	GetType(defender_type2)
	JumpIfStoredEQ(type.fire, &deprioritizeBy10)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_guard, &deprioritizeBy10)
	JumpIfStoredEQ(ability.heatproof, &deprioritizeBy10)
	JumpIfStoredEQ(ability.guts, &deprioritizeBy10)
	JumpIfStoredEQ(ability.flare_boost, &deprioritizeBy10)
	JumpIfStoredEQ(ability.rain_dish, &deprioritizeBy10)
	JumpIfHeldItemEQ(defender, item.lum_berry, &HighChanceToDeprioritizeBy10)
	JumpIfHeldItemEQ(defender, item.rawst_berry, &HighChanceToDeprioritizeBy10)
