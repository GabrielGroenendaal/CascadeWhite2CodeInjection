	JumpIfTargetIsAlly(&endScript_1)
	CalcMoveDamage(false)
	JumpIfStoredEQ(no_damage, &checkPowderImmunity)

address_StartProcessing:
	JumpIfEffectivenessEQ(0x, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &checkPowderImmunity)
	JumpIfStoredEQ(ability.turboblaze, &checkPowderImmunity)
	JumpIfStoredEQ(ability.teravolt, &checkPowderImmunity)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &checkPowderImmunity)
	JumpIfStoredNE(item.tera_drill, &checkPowderImmunity)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.volt_absorb, &checkElectricImmunity)
	JumpIfStoredEQ(ability.motor_drive, &checkElectricImmunity)
	JumpIfStoredEQ(ability.lightning_rod, &checkElectricImmunity)
	JumpIfStoredEQ(ability.thunder_armor, &checkElectricImmunity)
	JumpIfStoredEQ(ability.water_absorb, &checkWaterImmunity)
	JumpIfStoredEQ(ability.storm_drain, &checkWaterImmunity)
	JumpIfStoredEQ(ability.flash_fire, &checkFireImmunity)
	JumpIfStoredEQ(ability.well_baked_body, &checkFireImmunity)
	JumpIfStoredEQ(ability.wonder_guard, &checkWonderGuard)
	JumpIfStoredEQ(ability.levitate, &checkGroundImmunity)
	JumpIfStoredEQ(ability.dry_skin, &checkWaterImmunity)
	JumpIfStoredEQ(ability.sap_sipper, &checkGrassImmunity)
	Jump(&checkPowderImmunity)

checkElectricImmunity:
	GetType(move_type)
	JumpIfStoredEQ(type.electric, &deprioritizeBy12)
	Jump(&checkPowderImmunity)

checkWaterImmunity:
	GetType(move_type)
	JumpIfStoredEQ(type.water, &deprioritizeBy12)
	Jump(&checkPowderImmunity)

checkFireImmunity:
	GetType(move_type)
	JumpIfStoredEQ(type.fire, &deprioritizeBy12)
	Jump(&checkPowderImmunity)

checkWonderGuard:
	JumpIfEffectivenessEQ(2x, &checkPowderImmunity)
	JumpIfEffectivenessEQ(4x, &checkPowderImmunity)
	Jump(&deprioritizeBy12)

checkGroundImmunity:
	GetType(move_type)
	JumpIfStoredEQ(type.ground, &deprioritizeBy12)
	Jump(&checkPowderImmunity)

checkGrassImmunity:
	GetType(move_type)
	JumpIfStoredEQ(type.grass, &deprioritizeBy12)
	Jump(&checkPowderImmunity)

checkPowderImmunity:
	GetAbilityGuess(defender)
	JumpIfStoredNE(ability.overcoat, &checkPowderImmunity2)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &checkPowderImmunity2)
	JumpIfStoredEQ(ability.turboblaze, &checkPowderImmunity2)
	JumpIfStoredEQ(ability.teravolt, &checkPowderImmunity2)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &checkPowderImmunity2)
	JumpIfStoredNE(item.tera_drill, &checkPowderImmunity2)
	JumpIfMoveEQ(move.sleep_powder, &deprioritizeBy10)
	JumpIfMoveEQ(move.poison_powder, &deprioritizeBy10)
	JumpIfMoveEQ(move.stun_spore, &deprioritizeBy10)
	JumpIfMoveEQ(move.spore, &deprioritizeBy10)
	JumpIfMoveEQ(move.cotton_spore, &deprioritizeBy10)
	JumpIfMoveEQ(move.rage_powder, &deprioritizeBy10)

checkPowderImmunity2:
	GetHeldItem(defender)
	JumpIfStoredNE(item.safety_goggles, &checkSoundImmunity)
	JumpIfMoveEQ(move.sleep_powder, &deprioritizeBy10)
	JumpIfMoveEQ(move.poison_powder, &deprioritizeBy10)
	JumpIfMoveEQ(move.stun_spore, &deprioritizeBy10)
	JumpIfMoveEQ(move.spore, &deprioritizeBy10)
	JumpIfMoveEQ(move.cotton_spore, &deprioritizeBy10)
	JumpIfMoveEQ(move.rage_powder, &deprioritizeBy10)

checkSoundImmunity:
	GetAbilityGuess(defender)
	JumpIfStoredNE(ability.amplifier, &checkWindImmunity)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &moveOnToMoveEffects)
	JumpIfStoredEQ(ability.turboblaze, &moveOnToMoveEffects)
	JumpIfStoredEQ(ability.teravolt, &moveOnToMoveEffects)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &moveOnToMoveEffects)
	JumpIfStoredNE(item.tera_drill, &moveOnToMoveEffects)
	JumpIfMoveEQ(move.growl, &deprioritizeBy10)
	JumpIfMoveEQ(move.roar, &deprioritizeBy10)
	JumpIfMoveEQ(move.sing, &deprioritizeBy10)
	JumpIfMoveEQ(move.supersonic, &deprioritizeBy10)
	JumpIfMoveEQ(move.screech, &deprioritizeBy10)
	JumpIfMoveEQ(move.snore, &deprioritizeBy10)
	JumpIfMoveEQ(move.uproar, &deprioritizeBy10)
	JumpIfMoveEQ(move.metal_sound, &deprioritizeBy10)
	JumpIfMoveEQ(move.grass_whistle, &deprioritizeBy10)
	JumpIfMoveEQ(move.bug_buzz, &deprioritizeBy10)
	JumpIfMoveEQ(move.chatter, &deprioritizeBy10)
	JumpIfMoveEQ(move.disarming_voice, &deprioritizeBy10)
	JumpIfMoveEQ(move.echoed_voice, &deprioritizeBy10)
	JumpIfMoveEQ(move.relic_song, &deprioritizeBy10)
	JumpIfMoveEQ(move.clanging_scales, &deprioritizeBy10)
	JumpIfMoveEQ(move.alluring_voice, &deprioritizeBy10)
	JumpIfMoveEQ(move.torment, &deprioritizeBy10)
	JumpIfMoveEQ(move.hyper_voice, &deprioritizeBy10)
	JumpIfMoveEQ(move.boomburst, &deprioritizeBy10)
	JumpIfMoveEQ(move.psychic_noise, &deprioritizeBy10)
	JumpIfMoveEQ(move.snarl, &deprioritizeBy10)
	JumpIfMoveEQ(move.confide, &deprioritizeBy10)
	JumpIfMoveEQ(move.astonish, &deprioritizeBy10)

checkWindImmunity:
	GetAbilityGuess(defender)
	JumpIfStoredNE(ability.wind_rider, &checkBombImmunity)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &moveOnToMoveEffects)
	JumpIfStoredEQ(ability.turboblaze, &moveOnToMoveEffects)
	JumpIfStoredEQ(ability.teravolt, &moveOnToMoveEffects)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &moveOnToMoveEffects)
	JumpIfStoredNE(item.tera_drill, &moveOnToMoveEffects)
	JumpIfMoveEQ(move.icy_wind, &deprioritizeBy10)
	JumpIfMoveEQ(move.air_slash, &deprioritizeBy10)
	JumpIfMoveEQ(move.hurricane, &deprioritizeBy10)
	JumpIfMoveEQ(move.heat_wave, &deprioritizeBy10)
	JumpIfMoveEQ(move.ominous_wind, &deprioritizeBy10)
	JumpIfMoveEQ(move.silver_wind, &deprioritizeBy10)
	JumpIfMoveEQ(move.gust, &deprioritizeBy10)
	JumpIfMoveEQ(move.fairy_wind, &deprioritizeBy10)
	JumpIfMoveEQ(move.diamond_storm, &deprioritizeBy10)
	JumpIfMoveEQ(move.razor_winds, &deprioritizeBy10)
	JumpIfMoveEQ(move.aeroblast, &deprioritizeBy10)
	JumpIfMoveEQ(move.twister, &deprioritizeBy10)
	JumpIfMoveEQ(move.whirlwind, &deprioritizeBy10)
	JumpIfMoveEQ(move.air_cutter, &deprioritizeBy10)
	JumpIfMoveEQ(move.petal_blizzard, &deprioritizeBy10)
 
checkBombImmunity:
	GetAbilityGuess(defender)
	JumpIfStoredNE(ability.bulletproof, &moveOnToMoveEffects)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &moveOnToMoveEffects)
	JumpIfStoredEQ(ability.turboblaze, &moveOnToMoveEffects)
	JumpIfStoredEQ(ability.teravolt, &moveOnToMoveEffects)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &moveOnToMoveEffects)
	JumpIfStoredNE(item.tera_drill, &moveOnToMoveEffects)
	JumpIfMoveEQ(move.acid_spray, &deprioritizeBy10)
	JumpIfMoveEQ(move.aura_sphere, &deprioritizeBy10)
	JumpIfMoveEQ(move.barrage, &deprioritizeBy10)
	JumpIfMoveEQ(move.bullet_seed, &deprioritizeBy10)
	JumpIfMoveEQ(move.egg_bomb, &deprioritizeBy10)
	JumpIfMoveEQ(move.electro_ball, &deprioritizeBy10)
	JumpIfMoveEQ(move.energy_ball, &deprioritizeBy10)
	JumpIfMoveEQ(move.focus_blast, &deprioritizeBy10)
	JumpIfMoveEQ(move.gyro_ball, &deprioritizeBy10)
	JumpIfMoveEQ(move.magnet_bomb, &deprioritizeBy10)
	JumpIfMoveEQ(move.mud_bomb, &deprioritizeBy10)
	JumpIfMoveEQ(move.octazooka, &deprioritizeBy10)
	JumpIfMoveEQ(move.pollen_puff, &deprioritizeBy10)
	JumpIfMoveEQ(move.rock_blast, &deprioritizeBy10)
	JumpIfMoveEQ(move.rock_wrecker, &deprioritizeBy10)
	JumpIfMoveEQ(move.searing_shot, &deprioritizeBy10)
	JumpIfMoveEQ(move.seed_bomb, &deprioritizeBy10)
	JumpIfMoveEQ(move.shadow_ball, &deprioritizeBy10)
	JumpIfMoveEQ(move.sludge_bomb, &deprioritizeBy10)
	JumpIfMoveEQ(move.weather_ball, &deprioritizeBy10)
	JumpIfMoveEQ(move.zap_cannon, &deprioritizeBy10)

moveOnToMoveEffects:
	JumpTable(move_effect, 337, &data_address_MoveEffects)
	EndScript()



