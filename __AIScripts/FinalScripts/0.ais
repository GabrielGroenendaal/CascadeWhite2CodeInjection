	JumpIfBadlyPoisoned(attacker, &endScript_20)
	JumpIfHasCondition(attacker, cond.paralysis, &endScript_20)
	JumpIfHasCondition(attacker, cond.burn, &endScript_20)
	Jump(&deprioritizeBy10)

endScript_20:
	EndScript()















//   MUD SPORT   

Label_0x13EC:
	JumpIfFieldEffectEQ(field_ef.mud_sport, &deprioritizeBy10)
	EndScript()








//   TICKLE   

Label_Tickle:
	GetAbilityGuess(defender)
