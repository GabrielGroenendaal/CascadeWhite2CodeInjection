Label_Trick:
	GetHeldItem(defender)
	JumpIfStoredEQ(item.none, &deprioritizeBy10)
	EndScript()








//   KNOCK OFF   

Label_KnockOff:
	GetHeldItem(defender)
	JumpIfStoredEQ(item.none, &endScript_19)
	JumpIfRandGT(180, &prioritizeBy2)

endScript_19:
	EndScript()






