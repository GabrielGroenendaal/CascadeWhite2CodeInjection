//  SLEEP LOGIC 


Label_ApplySleep:
	JumpIfHasAnyStatus(defender, &deprioritizeBy10)
	JumpIfHasSideCondition(defender, side_cond.safeguard, &deprioritizeBy10)
	JumpIfHasSideCondition(defender, side_cond.mist, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &Label_SleepCheckItems)
	JumpIfStoredEQ(ability.turboblaze, &Label_SleepCheckItems)
	JumpIfStoredEQ(ability.teravolt, &Label_SleepCheckItems)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &Label_SleepCheckItems)
	JumpIfStoredNE(item.tera_drill, &Label_SleepCheckItems)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_bounce, &deprioritizeBy10)
	JumpIfStoredEQ(ability.vital_spirit, &deprioritizeBy10)
	

Label_SleepCheckItems:
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.shed_skin, &HighChanceToDeprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.unnerve, &endScript_2)
	JumpIfHeldItemEQ(defender, item.lum_berry, &HighChanceToDeprioritizeBy10)
	JumpIfHeldItemEQ(defender, item.chesto_berry, &HighChanceToDeprioritizeBy10)
	EndScript()

endScript_2:
	EndScript()





//  EXPLOSION LOGIC 


Label_ExplosionLogic:
	JumpIfEffectivenessEQ(0x, &deprioritizeBy10)
	GetPartyReserveCount(attacker)
	JumpIfStoredNE(0, &endScriptExplosion)
	GetPartyReserveCount(defender)
	JumpIfStoredNE(0, &deprioritizeBy10)
	Jump(&deprioritizeBy1)

endScriptExplosion:
	EndScript()




//   NIGHTMARE   

Label_Nightmare:
	JumpIfHasCondition(defender, cond.nightmare, &deprioritizeBy10)
	JumpIfNotCondition(defender, cond_flag.charge, &deprioritizeBy8)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_guard, &deprioritizeBy10)
	EndScript()



//   DREAM EATER   

Label_DreamEater:
	JumpIfNotCondition(defender, cond_flag.charge, &deprioritizeBy8)
	JumpIfEffectivenessEQ(0x, &deprioritizeBy10)
	EndScript()


Label_BellyDrum:
	JumpIfHealthLT(attacker, 51, &deprioritizeBy10)




//   STAT RAISING   

Label_RaiseAttack:
	JumpIfStatStageEQ(attacker, atk, +6, &deprioritizeBy10)
	EndScript()


Label_RaiseDefense:
	JumpIfStatStageEQ(attacker, def, +6, &deprioritizeBy10)
	EndScript()


Label_RaiseSpeed:
	JumpIfFieldEffectEQ(field_ef.trick_room, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, spe, +6, &deprioritizeBy10)
	EndScript()


Label_RaiseSpecialAttack:
	JumpIfStatStageEQ(attacker, spa, +6, &deprioritizeBy10)
	EndScript()


Label_RaiseSpecialDefense:
	JumpIfStatStageEQ(attacker, spd, +6, &deprioritizeBy10)
	EndScript()


Label_RaiseAccuracy:
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.no_guard, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.no_guard, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, acc, +6, &deprioritizeBy10)
	EndScript()


Label_RaiseEvasion:
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.no_guard, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.no_guard, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, eva, +6, &deprioritizeBy10)
	EndScript()


//   STAT LOWERING   

Label_LowerEnemyAttack:
	JumpIfStatStageEQ(defender, atk, -6, &deprioritizeBy10)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.defiant, &deprioritizeBy12)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &Label_CheckForStatBlockingAbilitiesAndItems)
	JumpIfStoredEQ(ability.turboblaze, &Label_CheckForStatBlockingAbilitiesAndItems)
	JumpIfStoredEQ(ability.teravolt, &Label_CheckForStatBlockingAbilitiesAndItems)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &Label_CheckForStatBlockingAbilitiesAndItems)
	JumpIfStoredNE(item.tera_drill, &Label_CheckForStatBlockingAbilitiesAndItems)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.hyper_cutter, &deprioritizeBy10)
	JumpIfStoredEQ(ability.scrappy, &deprioritizeBy10)
	Jump(&Label_CheckForStatBlockingAbilitiesAndItems)

Label_LowerEnemyDefense:
	JumpIfStatStageEQ(defender, def, -6, &deprioritizeBy10)
	Jump(&Label_CheckForStatBlockingAbilitiesAndItems)

Label_LowerEnemySpeed:
	JumpIfFieldEffectEQ(field_ef.trick_room, &deprioritizeBy10)
	JumpIfStatStageEQ(defender, spe, -6, &deprioritizeBy10)
	GetPokeHasAbility(defender, ability.speed_boost)
	JumpIfStoredEQ(true, &deprioritizeBy10)
	Jump(&Label_CheckForStatBlockingAbilitiesAndItems)

Label_LowerEnemySpecialAttack:
	JumpIfStatStageEQ(defender, spa, -6, &deprioritizeBy10)
	Jump(&Label_CheckForStatBlockingAbilitiesAndItems)

Label_LowerEnemySpecialDefense:
	JumpIfStatStageEQ(defender, spd, -6, &deprioritizeBy10)
	Jump(&Label_CheckForStatBlockingAbilitiesAndItems)

Label_LowerEnemyAccuracy:
	JumpIfStatStageEQ(defender, acc, -6, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.no_guard, &deprioritizeBy10)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.no_guard, &deprioritizeBy10)
	Jump(&Label_CheckForStatBlockingAbilitiesAndItems)

Label_LowerEnemyEvasion:
	JumpIfStatStageEQ(defender, eva, -6, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.no_guard, &deprioritizeBy10)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.no_guard, &deprioritizeBy10)

Label_CheckForStatBlockingAbilitiesAndItems:
	JumpIfHasSideCondition(defender, side_cond.safeguard, &deprioritizeBy10)
	JumpIfHasSideCondition(defender, side_cond.mist, &deprioritizeBy10)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.contrary, &deprioritizeBy12)
	JumpIfStoredEQ(ability.defiant, &deprioritizeBy12)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &endScript_3)
	JumpIfStoredEQ(ability.turboblaze, &endScript_3)
	JumpIfStoredEQ(ability.teravolt, &endScript_3)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &endScript_3)
	JumpIfStoredNE(item.tera_drill, &endScript_3)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.strong_body, &deprioritizeBy10)
	JumpIfStoredEQ(ability.white_smoke, &deprioritizeBy10)
	JumpIfStoredEQ(ability.magic_bounce, &deprioritizeBy12)
	JumpIfStoredEQ(ability.unaware, &deprioritizeBy12)
	
endScript_3:
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.unnerve, &endScript_3a)
	JumpIfHeldItemEQ(defender, item.white_herb, &HighChanceToDeprioritizeBy10)

endScript_3a:
	EndScript()



//   STAT NEUTRALIZING   

Label_StatNeutralizing:
	JumpIfStatStageLT(attacker, atk, +0, &endScript_4)
	JumpIfStatStageLT(attacker, def, +0, &endScript_4)
	JumpIfStatStageLT(attacker, spe, +0, &endScript_4)
	JumpIfStatStageLT(attacker, spa, +0, &endScript_4)
	JumpIfStatStageLT(attacker, spd, +0, &endScript_4)
	JumpIfStatStageLT(attacker, acc, +0, &endScript_4)
	JumpIfStatStageLT(attacker, eva, +0, &endScript_4)
	JumpIfStatStageGT(defender, atk, +0, &endScript_4)
	JumpIfStatStageGT(defender, def, +0, &endScript_4)
	JumpIfStatStageGT(defender, spe, +0, &endScript_4)
	JumpIfStatStageGT(defender, spa, +0, &endScript_4)
	JumpIfStatStageGT(defender, spd, +0, &endScript_4)
	JumpIfStatStageGT(defender, acc, +0, &endScript_4)
	JumpIfStatStageGT(defender, eva, +0, &endScript_4)
	Jump(&deprioritizeBy10)

endScript_4:
	EndScript()





//   PHASING   

Label_PhasingMoves:
	GetPartyReserveCount(defender)
	JumpIfStoredEQ(0, &deprioritizeBy10)
	EndScript()




//   HEALING   

Label_HealingForHealth:
	JumpIfHealthNE(attacker, 100, &endScript_5)
	AddToScore(-8)

endScript_5:
	EndScript()






