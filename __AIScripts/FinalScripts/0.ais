	JumpIfStoredEQ(type.poison, &Label_FlingToxicOrbAttackerChecks)
	JumpIfStoredEQ(type.steel, &Label_FlingToxicOrbAttackerChecks)
	GetType(defender_type2)
	JumpIfStoredEQ(type.poison, &Label_FlingToxicOrbAttackerChecks)
	JumpIfStoredEQ(type.steel, &Label_FlingToxicOrbAttackerChecks)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.toxic_boost, &Label_FlingToxicOrbAttackerChecks)
	JumpIfStoredEQ(ability.poison_heal, &Label_FlingToxicOrbAttackerChecks)
	JumpIfStoredEQ(ability.magic_guard, &Label_FlingToxicOrbAttackerChecks)
	JumpIfStoredEQ(ability.guts, &Label_FlingToxicOrbAttackerChecks)
	EndScript()


