	JumpIfStoredEQ(ability.strong_body, &deprioritizeBy10)
	JumpIfStoredEQ(ability.white_smoke, &deprioritizeBy10)
	JumpIfStoredEQ(ability.magic_bounce, &deprioritizeBy12)
	JumpIfStoredEQ(ability.hyper_cutter, &deprioritizeBy12)
	JumpIfStoredEQ(ability.scrappy, &deprioritizeBy12)
	JumpIfStoredEQ(ability.unaware, &deprioritizeBy12)
	GetAbilityGuess(attacker)
	

Label_TickleStatChecks:
	JumpIfStatStageEQ(defender, atk, -6, &deprioritizeBy10)
	JumpIfStatStageEQ(defender, def, -6, &deprioritizeBy8)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.unnerve, &endScript_Tickle)
	JumpIfHeldItemEQ(defender, item.white_herb, &HighChanceToDeprioritizeBy10)

endScript_Tickle:
	EndScript()









//   COSMIC POWER   

Label_CosmicPower:
	JumpIfStatStageEQ(attacker, def, +6, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, spd, +6, &deprioritizeBy8)
