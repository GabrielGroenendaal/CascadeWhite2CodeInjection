	JumpIfStoredEQ(type.fire, &deprioritizeBy5)
	GetType(attacker_type2)
	JumpIfStoredEQ(type.fire, &deprioritizeBy5)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.heatproof, &deprioritizeBy5)
