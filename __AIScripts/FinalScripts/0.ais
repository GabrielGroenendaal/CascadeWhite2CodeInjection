	EndScript()








//   BLOCK / MEANLOOK   

Label_Block:
	JumpIfHasCondition(defender, cond.block, &deprioritizeBy10)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.run_away, &deprioritizeBy12)
	JumpIfHeldItemEQ(defender, item.shed_shell, &deprioritizeBy12)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &endScript_13)
	JumpIfStoredEQ(ability.teravolt, &endScript_13)
	JumpIfStoredEQ(ability.turboblaze, &endScript_13)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &endScript_13)
	JumpIfStoredNE(item.tera_drill, &endScript_13)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_bounce, &deprioritizeBy12)

endScript_13:
	EndScript()









//   CURSE   

Label_Curse:
	GetType(attacker_type1)
	JumpIfStoredEQ(type.ghost, &Label_GhostCurseEffect)
	GetType(attacker_type2)
	JumpIfStoredEQ(type.ghost, &Label_GhostCurseEffect)
	JumpIfStatStageEQ(attacker, atk, +6, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, def, +6, &deprioritizeBy8)
	EndScript()


Label_GhostCurseEffect:
	JumpIfHasCondition(defender, cond.curse, &deprioritizeBy10)
	GetType(defender_type1)
	JumpIfStoredEQ(type.normal, &deprioritizeBy10)
	GetType(defender_type2)
	JumpIfStoredEQ(type.normal, &deprioritizeBy10)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_guard, &deprioritizeBy10)
	EndScript()










//   SPIKES   

Label_Spikes:
	GetSideStatusLevel(defender, side_cond.spikes)
	JumpIfStoredEQ(3, &deprioritizeBy10)
	GetPartyReserveCount(defender)
	JumpIfStoredEQ(0, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &endScript_14)
	JumpIfStoredEQ(ability.teravolt, &endScript_14)
	JumpIfStoredEQ(ability.turboblaze, &endScript_14)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &endScript_14)
	JumpIfStoredNE(item.tera_drill, &endScript_14)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_bounce, &deprioritizeBy12)

endScript_14:
	EndScript()









//   FORESIGHT   

Label_Foresight:
	JumpIfHasCondition(defender, cond.foresight, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &endScript_15)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_bounce, &deprioritizeBy12)

endScript_15:
	EndScript()









//   PERISH SONG   

Label_PerishSong:
	JumpIfHasCondition(defender, cond.perish_song, &deprioritizeBy10)
	EndScript()









//   SANDSTORM   

Label_Sandstorm:
	GetWeather()
	JumpIfStoredEQ(weather.sand, &deprioritizeBy8)
	EndScript()











//   ATTRACT   

Label_Attract:
	JumpIfHasCondition(defender, cond.infatuation, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &endScript_16)
	JumpIfStoredEQ(ability.turboblaze, &endScript_16)
	JumpIfStoredEQ(ability.teravolt, &endScript_16)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &endScript_16)
	JumpIfStoredNE(item.tera_drill, &endScript_16)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_bounce, &deprioritizeBy12)

endScript_16:
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.unnerve, &endScript_16a)
	JumpIfHeldItemEQ(defender, item.mental_herb, &HighChanceToDeprioritizeBy10)

endScript_16a:
	EndScript()










//   SAFEGUARD   

Label_Safeguard:
	JumpIfHasSideCondition(attacker, side_cond.safeguard, &deprioritizeBy8)
	JumpIfHasSideCondition(attacker, side_cond.mist, &deprioritizeBy8)
	EndScript()














//   MEMENTO - Unused   

Label_Memento:
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.contrary, &deprioritizeBy12)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &Label_MementoStatCheck)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.strong_body, &deprioritizeBy10)
	JumpIfStoredEQ(ability.white_smoke, &deprioritizeBy10)

Label_MementoStatCheck:
	JumpIfStatStageEQ(defender, atk, -6, &deprioritizeBy10)
	JumpIfStatStageEQ(defender, spa, -6, &deprioritizeBy8)
	GetPartyReserveCount(attacker)
	JumpIfStoredEQ(0, &deprioritizeBy10)
	EndScript()










//   BATON PASS   

Label_BatonPass:
	GetPartyReserveCount(attacker)
	JumpIfStoredEQ(0, &deprioritizeBy10)
	EndScript()








//   RAIN DANCE   

Label_RainDance:
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.swift_swim, &Label_ShouldChangeWeatherRain)
	JumpIfStoredEQ(ability.dry_skin, &Label_ShouldChangeWeatherRain)
	GetAbilityGuess(defender)
	JumpIfStoredNE(ability.dry_skin, &Label_ShouldChangeWeatherRain)

Label_ShouldChangeWeatherRain:
	GetWeather()
	JumpIfStoredEQ(weather.rain, &deprioritizeBy8)
	EndScript()











//   SUNNY DAY   

Label_SunnyDay:
	GetWeather()
	JumpIfStoredEQ(weather.sun, &deprioritizeBy8)
	EndScript()













//   FUTURE SIGHT   

Label_FutureSight:
	JumpIfAttackForeseen(defender, &deprioritizeBy12)
	EndScript()










//   FAKE OUT   

Label_FakeOut:
	StoreIsFirstTurn(attacker)
	JumpIfStoredEQ(false, &deprioritizeBy10)
	EndScript()










//   STOCKPILE, SPIT UP, & SWALLOW  

Label_Stockpile:
	GetHeldItem(attacker)
	JumpIfStoredIsNotInList(&array_Berries, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, def, +6, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, spd, +6, &deprioritizeBy10)
	JumpIfStoredIsInList(&array_StatBerries, &Label_StatBerryCheck);
	EndScript()

Label_SpitUpAndSwallow:
	GetHeldItem(attacker)
	JumpIfStoredIsNotInList(&array_Berries, &deprioritizeBy10)
	JumpIfMoveEffectEQ(move_ef.swallow, &Label_SwallowHealing)
	JumpIfStoredIsInList(&array_StatBerries, &Label_StatBerryCheck);
	EndScript()

Label_SwallowHealing:
	JumpIfHealthNE(attacker, 100, &endScript_5)
	JumpIfStoredIsInList(&array_StatBerries, &Label_StatBerryCheck);
	AddToScore(-8)
	EndScript();

Label_StatBerryCheck:
	JumpIfRandGT(230, &DeprioritizeEndScript)
	AddToScore(+2)
	EndScript();












//   HAIL   

Label_Hail:
	GetWeather()
	JumpIfStoredEQ(weather.hail, &deprioritizeBy8)
	EndScript()














//   TORMENT   

Label_Torment:
	JumpIfHasCondition(defender, cond.torment, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &endScript_17)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_bounce, &deprioritizeBy12)

endScript_17:
	EndScript()














//   WILL-O-WISP   

Label_WillOWisp:
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.guts, &deprioritizeBy10)
	JumpIfStoredEQ(ability.magic_guard, &deprioritizeBy10)
	JumpIfHasAnyStatus(defender, &deprioritizeBy10)
	GetType(defender_type1)
	JumpIfStoredEQ(type.fire, &deprioritizeBy10)
	GetType(defender_type2)
	JumpIfStoredEQ(type.fire, &deprioritizeBy10)
	JumpIfHasSideCondition(defender, side_cond.safeguard, &deprioritizeBy10)
	JumpIfHasSideCondition(defender, side_cond.mist, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &endScript_18)
	JumpIfStoredEQ(ability.turboblaze, &endScript_18)
	JumpIfStoredEQ(ability.teravolt, &endScript_18)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &endScript_18)
	JumpIfStoredNE(item.tera_drill, &endScript_18)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_bounce, &deprioritizeBy12)
	JumpIfStoredEQ(ability.flash_fire, &deprioritizeBy12)
	JumpIfStoredEQ(ability.well_baked_body, &deprioritizeBy12)
	JumpIfStoredEQ(ability.heatproof, &deprioritizeBy12)
	JumpIfStoredEQ(ability.rain_dish, &deprioritizeBy12)
	

endScript_18:
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.unnerve, &endScript_18a)
	JumpIfHeldItemEQ(defender, item.lum_berry, &HighChanceToDeprioritizeBy10)
	JumpIfHeldItemEQ(defender, item.rawst_berry, &HighChanceToDeprioritizeBy10)

endScript_18a:
	EndScript()













//   FOLLOW ME   

Label_FollowMe:
	GetBattleStyle()
	JumpIfStoredEQ(single_battle, &deprioritizeBy10)
	EndScript()











//   TAUNT   

Label_Taunt:
	JumpIfHasCondition(defender, cond.taunt, &deprioritizeBy10)
	EndScript()
















//   HELPING HAND   

Label_HelpingHand:
	GetBattleStyle()
	JumpIfStoredEQ(single_battle, &deprioritizeBy10)
	EndScript()

















