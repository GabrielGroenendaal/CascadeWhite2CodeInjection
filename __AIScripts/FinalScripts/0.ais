//   ACUPRESSURE   

Label_Acupressure:
	JumpIfStatStageEQ(attacker, atk, +6, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, def, +6, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, spe, +6, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, spa, +6, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, spd, +6, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, eva, +6, &deprioritizeBy10)
	JumpIfStatStageEQ(attacker, acc, +6, &deprioritizeBy10)
	EndScript()
















//   METAL BURST   

Label_MetalBurst:
	JumpIfEffectivenessEQ(0x, &deprioritizeBy10)
	GetHeldItemEffect(defender)
	JumpIfStoredEQ(item_ef.move_last, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.sturdy, &endScript_24)
	GetHeldItemEffect(attacker)
	JumpIfStoredEQ(item_ef.move_last, &endScript_24)

endScript_24:
	EndScript()

















//   EMBARGO   

Label_Embargo:
	JumpIfHasCondition(defender, cond.embargo, &deprioritizeBy10)
	GetUsedItem(defender)
	JumpIfStoredEQ(item.none, &endScript_25)
	GetBattleType()
	JumpIfStoredEQ(net_multi_vs_ai, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &endScript_25)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.magic_bounce, &deprioritizeBy12)

endScript_25:
	EndScript()















//   FLING   

Label_Fling:
	JumpIfEffectivenessEQ(0x, &deprioritizeBy10)
	GetFlingPower(attacker_type1)
	JumpIfStoredLT(10, &deprioritizeBy10)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.multitype, &deprioritizeBy10)
	GetHeldItemEffect(attacker)
	JumpIfStoredIsInList(&items_poison, &Label_FlingToxicOrb)
	JumpIfStoredIsInList(&items_fire, &Label_FlingBurningItem)
	JumpIfStoredIsInList(&items_paralysis, &Label_FlingParalyzeItem)
	EndScript()


Label_FlingToxicOrb:
	JumpIfHasSideCondition(defender, side_cond.safeguard, &Label_FlingToxicOrbAttackerChecks)
	JumpIfHasSideCondition(defender, side_cond.mist, &Label_FlingToxicOrbAttackerChecks)
