// MOVES THAT TARGET ALLIES 
address_TargetingAnAlly:
	JumpIfIsFainted(attacker_ally, &deprioritizeBy30Again)



    // NON DAMAGING MOVES
	CalcMoveDamage(false)
	JumpIfStoredEQ(no_damage, &address_NonDamagingAllyTargetingMoves)
	GetType(move_type)
	JumpIfStoredEQ(type.fire, &address_ConsiderSingleTargetFlashFireActivationMove)
	JumpIfStoredEQ(type.electric, &address_TargetAlliesElectricMoves)
	JumpIfStoredEQ(type.water, &address_WaterMoveLogicForSingleTargetMoves)

	
	JumpIfMoveEQ(move.fling, &address_TargetAllyWithBestow)
	JumpIfHeldItemEQ(attacker_ally, item.weakness_policy, &address_TriggerAllyWeaknessPolicy)
	JumpIfHeldItemEQ(attacker_ally, item.tera_w-policy, &address_TriggerAllyWeaknessPolicy)
	Jump(&deprioritizeBy30)







// FLASH FIRE LOGIC

address_ConsiderSingleTargetFlashFireActivationMove:
	GetPokeHasAbility(attacker_ally, ability.flash_fire)
	JumpIfStoredEQ(true, &address_CheckFlashFireActive)
	Jump(&deprioritizeBy30)

address_CheckFlashFireActive:
	JumpIfFlashFireIsActive(attacker_ally, &deprioritizeBy30)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &deprioritizeBy30)
	JumpIfStoredEQ(ability.turboblaze, &deprioritizeBy30)
	JumpIfStoredEQ(ability.teravolt, &deprioritizeBy30)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &deprioritizeBy30)
	JumpIfStoredNE(item.tera_drill, &deprioritizeBy30)
	JumpIfRandLT(150, &deprioritizeBy30)
	Jump(&add1ToScore)













address_TargetAlliesElectricMoves:
	GetPokeHasAbility(attacker_ally, ability.motor_drive)
	JumpIfStoredEQ(true, &address_AllyHasMotorDrive)
	GetPokeHasAbility(attacker_ally, ability.thunder_armor)
	JumpIfStoredEQ(true, &address_AllyHasThunderArmor)
	GetPokeHasAbility(attacker_ally, ability.lightning_rod)
	JumpIfStoredEQ(true, &address_AllyHasLightningRod)
	Jump(&deprioritizeBy30)

address_AllyHasThunderArmor:
	JumpIfStatStageGT(attacker_ally, atk, +1, &deprioritizeBy30)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &deprioritizeBy30)
	JumpIfStoredEQ(ability.turboblaze, &deprioritizeBy30)
	JumpIfStoredEQ(ability.teravolt, &deprioritizeBy30)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &deprioritizeBy30)
	JumpIfStoredNE(item.tera_drill, &deprioritizeBy30)
	Jump(&address_CheckAllyDamageIntakeForSideTargeting)

address_AllyHasLightningRod:
	JumpIfStatStageGT(attacker_ally, spa, +1, &deprioritizeBy30)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &deprioritizeBy30)
	JumpIfStoredEQ(ability.turboblaze, &deprioritizeBy30)
	JumpIfStoredEQ(ability.teravolt, &deprioritizeBy30)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &deprioritizeBy30)
	JumpIfStoredNE(item.tera_drill, &deprioritizeBy30)
	Jump(&address_CheckAllyDamageIntakeForSideTargeting)

address_AllyHasMotorDrive:
	JumpIfStatStageGT(attacker_ally, spe, +1, &deprioritizeBy30)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &deprioritizeBy30)
	JumpIfStoredEQ(ability.turboblaze, &deprioritizeBy30)
	JumpIfStoredEQ(ability.teravolt, &deprioritizeBy30)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &deprioritizeBy30)
	JumpIfStoredNE(item.tera_drill, &deprioritizeBy30)
	Jump(&address_CheckAllyDamageIntakeForSideTargeting)















// WATER MOVE LOGIC 

address_WaterMoveLogicForSingleTargetMoves:
	GetPokeHasAbility(attacker_ally, ability.storm_drain)
	JumpIfStoredEQ(true, &address_AllyHasStormDrain)
	Jump(&deprioritizeBy30)

address_AllyHasStormDrain:
	JumpIfStatStageGT(attacker_ally, spa, +1, &deprioritizeBy30)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &deprioritizeBy30)
	JumpIfStoredEQ(ability.turboblaze, &deprioritizeBy30)
	JumpIfStoredEQ(ability.teravolt, &deprioritizeBy30)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &deprioritizeBy30)
	JumpIfStoredNE(item.tera_drill, &deprioritizeBy30)
	Jump(&address_CheckAllyDamageIntakeForSideTargeting)







address_DarkTypeMoveLogicForSingleTargetMoves:
	GetPokeHasAbility(attacker_ally, ability.justified)
	JumpIfStoredEQ(true, &address_AllyHasJustified)
	Jump(&deprioritizeBy30)

address_AllyHasJustified:
	JumpIfStatStageGT(attacker_ally, atk, +1, &deprioritizeBy30)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.mold_breaker, &deprioritizeBy30)
	JumpIfStoredEQ(ability.turboblaze, &deprioritizeBy30)
	JumpIfStoredEQ(ability.teravolt, &deprioritizeBy30)
	GetHeldItem(attacker)
	JumpIfStoredNE(item.ability_drill, &deprioritizeBy30)
	JumpIfStoredNE(item.tera_drill, &deprioritizeBy30)
    CheckOwnDamageIntoAlly(&address_CheckAllyDamageIntakeForSideTargeting)
	Jump(&deprioritizeBy30)





//  TRIGGER ALLLY WEAKNESS POLICY 

address_TriggerAllyWeaknessPolicy:
	JumpIfEffectivenessEQ(2x, &address_hasSuperEffectiveMoveForWeaknessPolicy)
	JumpIfEffectivenessEQ(4x, &address_hasSuperEffectiveMoveForWeaknessPolicy)
	Jump(&deprioritizeBy30)

address_hasSuperEffectiveMoveForWeaknessPolicy:
	CheckOwnDamageIntoAlly(&address_CheckAllyDamageIntakeForSideTargeting)
	Jump(&deprioritizeBy30)








address_CheckAllyDamageIntakeForSideTargeting:
	JumpIfUserWillFaint_Priority(defender, &deprioritizeBy30)
	Jump(&address_RNGCheckForSideTargeting)

address_RNGCheckForSideTargeting:
	JumpIfRandLT(160, &endScript_RNGTargetingChecks)
	Jump(&add2ToScore)

endScript_RNGTargetingChecks:
	EndScript()





















// NON DAMAGING MOVES

address_NonDamagingAllyTargetingMoves:
	JumpIfMoveEQ(move.skill_swap, &address_TargetAllyWithSkillSwap)
	JumpIfMoveEQ(move.entrainment, &address_TargetAllyWithEntrainment)
	JumpIfMoveEQ(move.will-o-wisp, &address_TargetAllyWithWillOWisp)
	JumpIfMoveEQ(move.thunder_wave, &address_TargetAllyWithThunderWave)
	JumpIfMoveEffectEQ(move_ef.target_tox, &address_TargetAllyWithPoisoningMoves)
	JumpIfMoveEffectEQ(move_ef.target_psn, &address_TargetAllyWithPoisoningMoves)
	JumpIfMoveEQ(move.helping_hand, &address_TargetAllyWithHelpingHand)
	JumpIfMoveEQ(move.swagger, &address_TargetAllyWithSwagger)
    JumpIfMoveEQ(move.flatter, &address_TargetAllyWithFlatter)
	JumpIfMoveEQ(move.switcheroo, &address_TargetAllyWithBestow)
	JumpIfMoveEQ(move.bestow, &address_TargetAllyWithBestow)
	JumpIfMoveEQ(move.gastro_acid, &address_TargetAllyWithGastroAcid)
	JumpIfMoveEQ(move.acupressure, &address_TargetAllyWithAcupressure)
	JumpIfMoveEQ(move.agility, &address_TargetAllyWithAgility)
	JumpIfMoveEQ(move.heal_pulse, &address_TargetAllyWithHealPulse)
	Jump(&deprioritizeBy30Again)









//  SKILL SWAP 
address_TargetAllyWithSkillSwap:
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.truant, &add10ToScore)
	JumpIfStoredEQ(ability.slow_start, &add10ToScore)
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.levitate, &address_SkillSwapLevitateOntoAlly)
	JumpIfStoredEQ(ability.keen_senses, &address_SkillSwapAccuracyBoostingAbilityOntoAlly)
	JumpIfStoredEQ(ability.no_guard, &address_SkillSwapAccuracyBoostingAbilityOntoAlly)
	Jump(&deprioritizeBy30Again)

address_SkillSwapLevitateOntoAlly:
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.levitate, &deprioritizeBy10)
	GetType(defender_type1)
	JumpIfStoredEQ(type.flying, &deprioritizeBy8)
	GetType(defender_type2)
	JumpIfStoredEQ(type.flying, &deprioritizeBy8)
	GetType(defender_type1)
	JumpIfStoredEQ(type.grass, &deprioritizeBy5)
	JumpIfStoredEQ(type.bug, &deprioritizeBy5)
	GetType(defender_type2)
	JumpIfStoredEQ(type.grass, &deprioritizeBy5)
	JumpIfStoredEQ(type.bug, &deprioritizeBy5)
	JumpIfHasCondition(defender, cond.floating, &deprioritizeBy2)
	GetType(defender_type1)
	JumpIfStoredEQ(type.electric, &add3ToScore)
	GetType(defender_type2)
	JumpIfStoredEQ(type.electric, &add3ToScore)
	GetType(defender_type1)
	JumpIfStoredEQ(type.steel, &add3ToScore)
	GetType(defender_type2)
	JumpIfStoredEQ(type.steel, &add3ToScore)
	GetType(defender_type1)
	JumpIfStoredEQ(type.poison, &add3ToScore)
	GetType(defender_type2)
	JumpIfStoredEQ(type.poison, &add3ToScore)
	GetType(defender_type1)
	JumpIfStoredEQ(type.fire, &add3ToScore)
	GetType(defender_type2)
	JumpIfStoredEQ(type.fire, &add3ToScore)
	GetType(defender_type1)
	JumpIfStoredEQ(type.rock, &add3ToScore)
	GetType(defender_type2)
	JumpIfStoredEQ(type.rock, &add3ToScore)
	Jump(&deprioritizeBy30Again)

address_SkillSwapAccuracyBoostingAbilityOntoAlly:
	JumpIfHasMove(attacker_ally, move.fire_blast, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.thunder, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.scorching_swarm, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.hydro_pump, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.dynamic_punch, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.blizzard, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.zap_cannon, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.megahorn, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.focus_blast, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.gunk_shot, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.magma_storm, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.power_whip, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.seed_flare, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.hurricane, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.inferno, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.fissure, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.guillotine, &address_Add3ToScoreForSkillSwapAccuracy)
	JumpIfHasMove(attacker_ally, move.horn_drill, &address_Add3ToScoreForSkillSwapAccuracy)
	Jump(&deprioritizeBy30Again)

address_Add3ToScoreForSkillSwapAccuracy:
	Jump(&add3ToScore)












// TARGET ALLY WITH ENTRAINMENT

address_TargetAllyWithEntrainment:
	GetAbilityGuess(defender)
	JumpIfStoredIsInList(&data_address_GreatAbilitiesToTakeWithRolePlay, &deprioritizeBy30Again)
	GetAbilityGuess(attacker)
	JumpIfStoredIsInList(&data_address_GreatAbilitiesToTakeWithRolePlay, &address_AddScoreForEntrainment)
	JumpIfRandLT(128, &deprioritizeBy30Again)
	GetAbilityGuess(defender)
	JumpIfStoredIsInList(&data_address_SecondarilyGreatAbilities, &deprioritizeBy30Again)
	GetAbilityGuess(attacker)
	JumpIfStoredIsInList(&data_address_SecondarilyGreatAbilities, &address_AddScoreForEntrainment)
	Jump(&deprioritizeBy30Again)

address_AddScoreForEntrainment:
	JumpIfUserWillFaint_Priority(defender, &deprioritizeBy30Again)
	Jump(&address_RNGForEntrainment)

address_RNGForEntrainment:
	JumpIfRandLT(50, &address_0x152C)
	AddToScore(1)

address_0x152C:
	EndScript()


data_address_GreatAbilitiesToTakeWithRolePlay:
	ability.permafrost
	ability.friend_guard
	ability.speed_boost
	ability.intimidate
	ability.pure_power
	ability.huge_power
	ability.fur_coat
	ability.anticipation
	ability.cursed_body
	ability.moody
	ability.plus
	ability.minus
	ability.aftermath
	END

data_address_SecondarilyGreatAbilities:
	ability.solar_power
	ability.dry_skin
	ability.motor_drive
	ability.rain_dish
	ability.huge_power
	ability.chlorophyll
	ability.swift_swim
	ability.ice_body
	ability.sand_rush
	ability.sand_veil
	ability.snow_cloak
	END




// TARGET ALLY WITH WILL-O-WISP

address_TargetAllyWithWillOWisp:
	Jump(&deprioritizeBy30Again)

address_TargetAllyWithThunderWave:
	Jump(&deprioritizeBy30Again)

address_TargetAllyWithPoisoningMoves:
	Jump(&deprioritizeBy30Again)

address_TargetAllyWithHelpingHand:
	JumpIfHealthEQ(attacker_ally, 0, &deprioritizeBy30)
	JumpIfHealthGT(attacker_ally, 50, &address_HighChanceToIncreaseScore)
	GetPosInTurnOrder(attacker_ally)
	JumpIfStoredLT(1, &address_HighChanceToIncreaseScore)
	AddToScore(-1)
	Jump(&address_0x16D6)

address_HighChanceToIncreaseScore:
	JumpIfRandSeedLT(128, &address_0x16D6)
	AddToScore(3)

address_0x16D6:
	EndScript()





// TARGET ALLY WITH SWAGGER

address_TargetAllyWithSwagger:
	JumpIfAtkLTSpa(attacker_ally, &deprioritizeBy30Again)
    GetType(attacker_type1)
    JumpIfStoredEQ(type.psychic, &address_CheckIncomingDamage)
    GetType(attacker_type2)
    JumpIfStoredEQ(type.psychic, &address_CheckIncomingDamage)
	JumpIfHeldItemEQ(attacker_ally, item.persim_berry, &address_CheckIncomingDamage)
	JumpIfHeldItemEQ(attacker_ally, item.lum_berry, &address_CheckIncomingDamage)
	JumpIfHasSideCondition(attacker_ally, side_cond.safeguard, &address_CheckIncomingDamage)
	JumpIfHasSideCondition(attacker_ally, side_cond.mist, &address_CheckIncomingDamage)
    
	Jump(&deprioritizeBy30Again)

address_CheckIncomingDamage:
	JumpIfUserWillFaint_Priority(attacker_ally, &deprioritizeBy30Again)
	Jump(&address_SwaggerRNGCheck)

address_SwaggerRNGCheck:
	JumpIfStatStageGT(attacker_ally, atk, +1, &endScript_SwaggerTargetAllyChecks)
	AddToScore(3)

endScript_SwaggerTargetAllyChecks:
	EndScript()




// TARGET ALLY WITH Flatter

address_TargetAllyWithFlatter:
	JumpIfAtkGTSpa(attacker_ally, &deprioritizeBy30Again)
    GetType(attacker_type1)
    JumpIfStoredEQ(type.psychic, &address_CheckIncomingDamage_Flatter)
    GetType(attacker_type2)
    JumpIfStoredEQ(type.psychic, &address_CheckIncomingDamage_Flatter)
	JumpIfHeldItemEQ(attacker_ally, item.persim_berry, &address_CheckIncomingDamage_Flatter)
	JumpIfHeldItemEQ(attacker_ally, item.lum_berry, &address_CheckIncomingDamage_Flatter)
	JumpIfHasSideCondition(attacker_ally, side_cond.safeguard, &address_CheckIncomingDamage_Flatter)
	JumpIfHasSideCondition(attacker_ally, side_cond.mist, &address_CheckIncomingDamage_Flatter)
	Jump(&deprioritizeBy30Again)

address_CheckIncomingDamage_Flatter:
	JumpIfUserWillFaint_Priority(attacker_ally, &deprioritizeBy30Again)
	Jump(&address_FlatterRNGCheck)

address_FlatterRNGCheck:
	JumpIfStatStageGT(attacker_ally, spa, +1, &endScript_FlatterTargetAllyChecks)
	AddToScore(3)

endScript_FlatterTargetAllyChecks:
	EndScript()







address_TargetAllyWithBestow:
	Jump(&deprioritizeBy30Again)







// TARGET ALLY WITH GASTRO ACID 

address_TargetAllyWithGastroAcid:
	JumpIfHasCondition(attacker_ally, cond.gastro_acid, &deprioritizeBy30Again)
	GetPokeHasAbility(attacker_ally, ability.truant)
	JumpIfStoredEQ(true, &address_0x1D32)
	GetPokeHasAbility(attacker_ally, ability.slow_start)
	JumpIfStoredEQ(true, &address_0x1D32)
	Jump(&address_0x1D38)

address_0x1D32:
	AddToScore(5)

address_0x1D38:
	EndScript()






address_TargetAllyWithAgility: 
	JumpCompareSpeed(GT, &address_AgilityEndScript)
	JumpIfStatStageEQ(attacker_ally, spe, +2, &deprioritizeBy30Again)
	JumpIfRandLT(128, &address_AgilityEndScript)
	AddToScore(2)

address_AgilityEndScript: 
	EndScript()



address_TargetAllyWithAcupressure:
	JumpIfStatStageEQ(attacker_ally, atk, +6, &deprioritizeBy30Again)
	JumpIfStatStageEQ(attacker_ally, def, +6, &deprioritizeBy30Again)
	JumpIfStatStageEQ(attacker_ally, spe, +6, &deprioritizeBy30Again)
	JumpIfStatStageEQ(attacker_ally, spa, +6, &deprioritizeBy30Again)
	JumpIfStatStageEQ(attacker_ally, spd, +6, &deprioritizeBy30Again)
	JumpIfStatStageEQ(attacker_ally, eva, +6, &deprioritizeBy30Again)
	JumpIfStatStageEQ(attacker_ally, acc, +6, &deprioritizeBy30Again)
	JumpIfUserWillFaint_Priority(defender, &deprioritizeBy30Again)
	Jump(&address_AcupressureRNGCheck)

address_AcupressureRNGCheck:
	JumpIfRandLT(128, &endScript_AcuPressureOnAlly)
	AddToScore(2)

endScript_AcuPressureOnAlly:
	EndScript()






address_TargetAllyWithHealPulse:
	JumpIfHealthEQ(defender, 0, &deprioritizeBy30Again)
	JumpIfHealthGT(defender, 100, &deprioritizeBy30Again)
	JumpIfHealthGT(defender, 70, &address_0x1F6C)
	JumpIfHealthGT(defender, 30, &address_HealPulseAllyDamageCheck)
	JumpIfStatStageGT(attacker_ally, def, +1, &address_HealPulseAllyDamageCheck)
	JumpIfStatStageGT(attacker_ally, spd, +1, &address_HealPulseAllyDamageCheck)
	JumpIfStatStageGT(attacker_ally, eva, +1, &address_HealPulseAllyDamageCheck)
	GetPosInTurnOrder(attacker)
	JumpIfStoredEQ(0, &address_HealPulseAllyDamageCheck)
	GetPosInTurnOrder(attacker_ally)
	JumpIfStoredNE(0, &deprioritizeBy1)
	GetPosInTurnOrder(attacker)
	JumpIfStoredEQ(1, &address_HealPulseAllyDamageCheck)
	Jump(&deprioritizeBy1)

address_0x1F6C:
	GetPosInTurnOrder(attacker)
	JumpIfStoredEQ(3, &address_HealPulseAllyDamageCheck)
	Jump(&deprioritizeBy1)

address_HealPulseAllyDamageCheck:
	JumpIfUserWillFaint_Priority(defender, &deprioritizeBy1)
	Jump(&address_HealPulseAllyRNGCheck)

address_HealPulseAllyRNGCheck:
	JumpIfRandSeedLT(128, &deprioritizeBy1)
	AddToScore(3)
	Jump(&deprioritizeBy1)

deprioritizeBy1:
	AddToScore(-1)
	EndScript()


deprioritizeBy30Again:
	AddToScore(-30)
	EndScript()

	0x0004 [4]
	0xFFFF [65535]
	0xFFFF [65535]
	0x004D [77]

deprioritizeBy2:
	AddToScore(-2)
	EndScript()


deprioritizeBy3:
	AddToScore(-3)
	EndScript()


deprioritizeBy5:
	AddToScore(-5)
	EndScript()

	0x0004 [4]
	0xFFFA [65530]
	0xFFFF [65535]
	0x004D [77]

deprioritizeBy8:
	AddToScore(-8)
	EndScript()


deprioritizeBy10:
	AddToScore(-10)
	EndScript()

	0x0004 [4]
	0xFFF4 [65524]
	0xFFFF [65535]
	0x004D [77]

deprioritizeBy30:
	AddToScore(-30)
	EndScript()


add1ToScore:
	AddToScore(1)
	EndScript()


add2ToScore:
	AddToScore(2)
	EndScript()


add3ToScore:
	AddToScore(3)
	EndScript()


add5ToScore:
	AddToScore(5)
	EndScript()


add10ToScore:
	AddToScore(10)
	EndScript()


BufferScriptCall:
	AddToScore(10)
	EndScript()
