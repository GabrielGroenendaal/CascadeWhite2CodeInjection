	JumpIfStoredEQ(true, &address_HighChanceToIncreaseScoreForDischarge)
	GetPokeHasAbility(attacker_ally, ability.lightning_rod)
	JumpIfStoredEQ(true, &address_HighChanceToIncreaseScoreForDischarge)
