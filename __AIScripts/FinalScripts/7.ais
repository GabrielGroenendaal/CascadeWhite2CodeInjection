// EARTHQUAKE LOGIC

address_EarthquakeLogic:
	JumpIfHasCondition(attacker_ally, cond.floating, &address_Earthquake_ChanceToAdd2ToScore)
	GetPokeHasAbility(attacker_ally, ability.levitate)
	JumpIfStoredEQ(true, &address_Earthquake_ChanceToAdd2ToScore)
	GetPokeHasAbility(attacker_ally, ability.healer)
	JumpIfStoredEQ(true, &address_Earthquake_ChanceToAdd2ToScore)
	GetPokeHasAbility(attacker_ally, ability.friend_guard)
	JumpIfStoredEQ(true, &address_Earthquake_ChanceToAdd2ToScore)
	GetPokeHasAbility(attacker_ally, ability.forewarn)
	JumpIfStoredEQ(true, &address_Earthquake_ChanceToAdd2ToScore)
	GetPokeHasAbility(attacker_ally, ability.plus)
	JumpIfStoredEQ(true, &address_Earthquake_ChanceToAdd2ToScore)
	GetPokeHasAbility(attacker_ally, ability.minus)
	JumpIfStoredEQ(true, &address_Earthquake_ChanceToAdd2ToScore)
	GetPokeHasType(attacker_ally, type.flying)
	JumpIfStoredEQ(true, &address_Earthquake_ChanceToAdd2ToScore)
	GetPokeHasType(attacker_ally, type.fire)
	JumpIfStoredEQ(true, &deprioritizeBy10)
	GetPokeHasType(attacker_ally, type.electric)
	JumpIfStoredEQ(true, &deprioritizeBy10)
	GetPokeHasType(attacker_ally, type.poison)
	JumpIfStoredEQ(true, &deprioritizeBy10)
	GetPokeHasType(attacker_ally, type.rock)
	JumpIfStoredEQ(true, &deprioritizeBy10)
	Jump(&deprioritizeBy3)

address_Earthquake_ChanceToAdd2ToScore:
	JumpIfRandLT(102, &endScript_5)
	Jump(&add2ToScore)

endScript_5:
	EndScript()




