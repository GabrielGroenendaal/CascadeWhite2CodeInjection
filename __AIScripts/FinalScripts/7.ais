// ally switch logic 
address_AllySwitchLogic:
	GetSpecies(defender)
	JumpIfStoredIsInList(&data_address_0x0E9C, &address_0x0E64)
	Jump(&address_0x0E9A)

address_0x0E64:
	StoreIsFirstTurn(defender)
	JumpIfStoredNE(false, &address_0x0E9A)
	JumpIfRandLT(128, &address_0x0E9A)
	AddToScore(2)
	Jump(&address_0x0E9A)
	JumpIfRandLT(128, &address_0x0E9A)
	AddToScore(-1)

address_0x0E9A:
	EndScript()


data_address_0x0E9C:
	species.blastoise
	species.persian
	species.dewgong
	species.kangaskhan
	species.mr_mime
	species.pikachu
	species.raichu
	species.ambipom
	species.weavile
	species.hitmonchan
	species.hitmonlee
	species.hitmontop
	species.jynx
	species.ludicolo
	species.shiftry
	species.hariyama
	species.delcatty
	species.sableye
	species.medicham
	species.spinda
	species.kecleon
	species.infernape
	species.lopunny
	species.purugly
	species.croagunk
	species.delibird
	species.scrafty
	species.liepard
	END




