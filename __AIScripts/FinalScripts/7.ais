	JumpIfStoredEQ(true, &addressSpreadElectricRNG)
	GetPokeHasAbility(defender_ally, ability.volt_absorb)
	JumpIfStoredEQ(true, &addressSpreadElectricRNG)
	Jump(&endScript_ElectricMoves)

addressSpreadElectricRNG:
	JumpIfRandLT(96, &endScript_ElectricMoves)
	AddToScore(-8)
	Jump(&endScript_ElectricMoves)

address_Discharge:
	GetPokeHasAbility(defender_ally, ability.lightning_rod)
	JumpIfStoredEQ(true, &address_DischargeChecks)
	GetPokeHasAbility(defender_ally, ability.thunder_armor)
