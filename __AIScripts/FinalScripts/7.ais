// SKILL SWAP LOGIC

address_SkillSwapLogic:
	GetAbilityGuess(attacker)
	JumpIfStoredEQ(ability.truant, &add5ToScore)
	JumpIfStoredEQ(ability.slow_start, &add5ToScore)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.intimidate, &add2ToScore)
	JumpIfStoredEQ(ability.shadow_tag, &add2ToScore)
	JumpIfStoredEQ(ability.pure_power, &add2ToScore)
	JumpIfStoredEQ(ability.huge_power, &add2ToScore)
	JumpIfStoredEQ(ability.mold_breaker, &add2ToScore)
	JumpIfStoredEQ(ability.solid_rock, &add2ToScore)
	JumpIfStoredEQ(ability.filter, &add2ToScore)
	JumpIfStoredEQ(ability.flower_gift, &add2ToScore)
	EndScript()





// NORMAL TYPE MOVES

normalTypeMoveLogic:
    JumpIfMoveEQ(move.boomburst, &address_BoomburstChecks)
    GetPokeHasAbility(attacker, ability.galvanize)
    JumpIfStoredEQ(true, &address_GalvanizeChecks)
    GetPokeHasAbility(attacker, ability.moisturize)
    JumpIfStoredEQ(true, &address_MoisturizeChecks)
	Jump(&endScript_NormalMoves)

address_BoomburstChecks:
	GetPokeHasAbility(attacker_ally, ability.amplifier)
	JumpIfStoredEQ(true, &address_HighChanceToIncreaseBoomburstScore)
    GetPokeHasAbility(attacker_ally, ability.healer)
	JumpIfStoredEQ(true, &address_HighChanceToIncreaseBoomburstScore)
	GetPokeHasAbility(attacker_ally, ability.friend_guard)
	JumpIfStoredEQ(true, &address_HighChanceToIncreaseBoomburstScore)
	GetPokeHasAbility(attacker_ally, ability.forewarn)
	JumpIfStoredEQ(true, &address_HighChanceToIncreaseBoomburstScore)
	GetPokeHasAbility(attacker_ally, ability.plus)
	JumpIfStoredEQ(true, &address_HighChanceToIncreaseBoomburstScore)
	GetPokeHasAbility(attacker_ally, ability.minus)
	JumpIfStoredEQ(true, &address_HighChanceToIncreaseBoomburstScore)
	GetPokeHasType(attacker_ally, type.ghost)
	JumpIfStoredEQ(true, &address_HighChanceToIncreaseBoomburstScore)
	GetPokeHasType(attacker_ally, type.steel)
	JumpIfStoredEQ(true, &address_MedChanceToIncreaseBoomburstScore)
	GetPokeHasType(attacker_ally, type.rock)
	JumpIfStoredEQ(true, &address_MedChanceToIncreaseBoomburstScore)
	AddToScore(-3)
	Jump(&endScript_NormalMoves)

address_HighChanceToIncreaseBoomburstScore:
	JumpIfRandLT(68, &endScript_NormalMoves)
	AddToScore(3)
	Jump(&endScript_NormalMoves)

address_MedChanceToIncreaseBoomburstScore:
	JumpIfRandLT(140, &endScript_NormalMoves)
	AddToScore(3)
	Jump(&endScript_NormalMoves)

endScript_NormalMoves:
	EndScript()



// DISCHARGE LOGIC 

electricTypeMoveLogic:
	JumpIfMoveEQ(move.discharge, &address_Discharge)
	JumpIfMoveEQ(move.electroweb, &address_SpreadElectricMoves)
	JumpIfMoveEQ(move.wild_charge, &address_SpreadElectricMoves)
	GetPokeHasAbility(attacker, ability.galvanize)
	JumpIfStoredEQ(true, &address_GalvanizeChecks)
	Jump(&endScript_ElectricMoves)

address_GalvanizeChecks:
	JumpIfMoveEQ(move.boomburst, &address_Discharge)
	JumpIfMoveEQ(move.uproar, &address_SpreadElectricMoves)
	JumpIfMoveEQ(move.take_down, &address_SpreadElectricMoves)
	JumpIfMoveEQ(move.double-edge, &address_SpreadElectricMoves)
	JumpIfMoveEQ(move.hyper_voice, &address_SpreadElectricMoves)
	JumpIfMoveEQ(move.swift, &address_SpreadElectricMoves)
	Jump(&endScript_ElectricMoves)

address_SpreadElectricMoves:
	GetPokeHasAbility(defender_ally, ability.lightning_rod)
	JumpIfStoredEQ(true, &addressSpreadElectricRNG)
	GetPokeHasAbility(defender_ally, ability.motor_drive)
	JumpIfStoredEQ(true, &addressSpreadElectricRNG)
