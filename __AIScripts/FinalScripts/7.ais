

	GetBattleStyle()
	JumpIfStoredEQ(double_battle, &MultiBattleLogic)
	JumpIfStoredEQ(triple_battle, &MultiBattleLogic)
	EndScript()


MultiBattleLogic:
	JumpIfMoveEQ(move.howl, &address_HowlLogic)
	JumpIfTargetIsAlly(&address_TargetingAnAlly)
	CalcMoveDamage(false)
	JumpIfStoredEQ(no_damage, &address_MoveDealsNoDamage)
	JumpIfMoveEffectEQ(move_ef.ohko, &Label_StaticDamageFunctions)
	JumpIfMoveEffectEQ(move_ef.direct_40, &Label_StaticDamageFunctions)
	JumpIfMoveEffectEQ(move_ef.direct_level, &Label_StaticDamageFunctions)
	JumpIfMoveEffectEQ(move_ef.psywave, &Label_StaticDamageFunctions)
	JumpIfMoveEffectEQ(move_ef.direct_30, &Label_StaticDamageFunctions)
	JumpIfEffectivenessEQ(1/2x, &Label_HalfEffectivenessMoves)
	JumpIfEffectivenessEQ(1/4x, &Label_QuarterEffectivenessMoves)
	Jump(&Label_StaticDamageFunctions)

Label_HalfEffectivenessMoves:
	JumpIfTargetWillFaint(false, &Label_StaticDamageFunctions)
	JumpIfHealthEQ(defender_ally, 0, &Label_StaticDamageFunctions)
	JumpIfRandLT(64, &Label_StaticDamageFunctions)
	AddToScore(-1)
	Jump(&Label_StaticDamageFunctions)

Label_QuarterEffectivenessMoves:
	JumpIfTargetWillFaint(false, &Label_StaticDamageFunctions)
	JumpIfHealthEQ(defender_ally, 0, &Label_StaticDamageFunctions)
	JumpIfRandLT(64, &Label_StaticDamageFunctions)
	AddToScore(-2)
	Jump(&Label_StaticDamageFunctions)

Label_StaticDamageFunctions:
	JumpIfMoveEffectEQ(move_ef.explosion, &address_MoveDealsNoDamage)
	JumpIfMoveEffectEQ(move_ef.increased_priority, &address_IncreaseScoreLikelyBy1)
	JumpIfRandLT(128, &Label_MoveLogicStage2)
	AddToScore(1)
	Jump(&address_MoveDealsNoDamage)

address_IncreaseScoreLikelyBy1:
	Jump(&address_MoveDealsNoDamage)

Label_MoveLogicStage2:
	JumpIfMoveEffectEQ(move_ef.ohko, &address_MoveDealsNoDamage)
	JumpIfMoveEffectEQ(move_ef.direct_40, &address_MoveDealsNoDamage)
	JumpIfMoveEffectEQ(move_ef.direct_level, &address_MoveDealsNoDamage)
	JumpIfMoveEffectEQ(move_ef.psywave, &address_MoveDealsNoDamage)
	JumpIfMoveEffectEQ(move_ef.direct_30, &address_MoveDealsNoDamage)
	JumpIfEffectivenessEQ(2x, &address_SuperEffectiveMove)
	JumpIfEffectivenessEQ(4x, &address_QuadrupleEffectiveMove)
	Jump(&address_MoveDealsNoDamage)

address_SuperEffectiveMove:
	JumpIfRandLT(100, &address_MoveDealsNoDamage)
	AddToScore(1)
	Jump(&address_MoveDealsNoDamage)

address_QuadrupleEffectiveMove:
	JumpIfRandLT(64, &address_MoveDealsNoDamage)
	AddToScore(1)
	Jump(&address_MoveDealsNoDamage)

address_MoveDealsNoDamage:
	JumpIfMoveEffectEQ(move_ef.dmg_force_switch, &endScript_1)
	JumpIfMoveEffectEQ(move_ef.dmg_user_hp_pct, &endScript_1)
	JumpIfMoveEQ(move.blizzard, &endScript_1)
	JumpIfMoveEQ(move.wide_guard, &address_WideGuardLogic)
	JumpIfMoveEQ(move.ally_switch, &address_AllySwitchLogic)
	JumpIfMoveEQ(move.skill_swap, &address_SkillSwapLogic)
	GetType(move_type)
	JumpIfMoveEQ(move.earthquake, &address_EarthquakeLogic)
	JumpIfMoveEQ(move.bulldoze, &address_EarthquakeLogic)
	JumpIfMoveEQ(move.future_sight, &address_FutureSightLogic)
	JumpIfMoveEQ(move.doom_desire, &address_FutureSightLogic)
	JumpIfMoveEQ(move.rain_dance, &address_RainDanceLogic)
	JumpIfMoveEQ(move.sunny_day, &address_SunnyDayLogic)
	JumpIfMoveEQ(move.hail, &address_HailLogic)
	JumpIfMoveEQ(move.sandstorm, &address_SandstormLogic)
	JumpIfMoveEQ(move.gravity, &address_GravityLogic)
	JumpIfMoveEQ(move.trick_room, &address_TrickRoomLogic)
	JumpIfMoveEQ(move.follow_me, &address_FollowMeLogic)
	JumpIfMoveEQ(move.heal_pulse, &deprioritizeBy40)
	JumpIfMoveEQ(move.helping_hand, &deprioritizeBy40)
	GetType(move_type)
	JumpIfStoredEQ(type.electric, &electricTypeMoveLogic)
	JumpIfStoredEQ(type.fire, &fireTypeMoveLogic)
	JumpIfStoredEQ(type.water, &waterTypeMoveLogic)
	JumpIfStoredEQ(type.normal, &normalTypeMoveLogic)
	JumpIfStoredEQ(type.grass, &grassTypeMoveLogic)
    JumpIfStoredEQ(type.dark, &darkTypeMoveLogic)
	JumpIfHasMove(attacker_ally, move.helping_hand, &HelpingHandLogic)
	EndScript()







address_HowlLogic: 
	JumpIfRandLT(64, &Label_EndHowlScript)
	AddToScore(1)

Label_EndHowlScript: 
	EndScript()




