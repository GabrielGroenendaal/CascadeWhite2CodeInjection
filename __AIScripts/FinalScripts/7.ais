	GetPokeHasType(attacker_ally, type.flying)
	JumpIfStoredEQ(true, &deprioritizeBy10)
	AddToScore(-3)
	Jump(&endScript_ElectricMoves)

address_HighChanceToIncreaseScoreForDischarge:
	JumpIfRandLT(68, &endScript_ElectricMoves)
	AddToScore(3)
	Jump(&endScript_ElectricMoves)

address_DischargeChecks:
	JumpIfRandLT(68, &endScript_ElectricMoves)
