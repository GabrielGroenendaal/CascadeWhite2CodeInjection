// TRICK ROOM LOGIC

address_TrickRoomLogic:
	JumpIfHealthEQ(attacker_ally, 0, &deprioritizeBy30)
	JumpIfHealthEQ(defender_ally, 0, &deprioritizeBy30)
	JumpIfHealthEQ(defender, 0, &deprioritizeBy30)
	GetPosInTurnOrder(attacker)
	JumpIfStoredEQ(0, &address_0x071C)
	JumpIfStoredEQ(1, &address_0x073C)
	JumpIfStoredEQ(2, &address_0x0752)
	JumpIfStoredEQ(3, &address_0x0778)
	Jump(&address_0x07A4)

address_0x071C:
	GetPosInTurnOrder(attacker_ally)
	JumpIfStoredEQ(1, &deprioritizeBy30)
	JumpIfStoredEQ(0, &deprioritizeBy30)
	Jump(&address_0x079E)

address_0x073C:
	GetPosInTurnOrder(attacker_ally)
	JumpIfStoredEQ(0, &deprioritizeBy30)
	Jump(&address_0x079E)

address_0x0752:
	GetPosInTurnOrder(attacker_ally)
	JumpIfStoredNE(3, &address_0x079E)
	JumpIfRandLT(64, &address_0x079E)
	AddToScore(5)
	Jump(&address_0x07A4)

address_0x0778:
