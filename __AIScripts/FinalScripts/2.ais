//   SLEEP   

Label_ApplySleep:
	JumpIfHasMoveWithEffect(attacker, move_ef.dream_eater, &Label_ApplySleepAddScore)
	JumpIfHasMoveWithEffect(attacker, move_ef.nightmare, &Label_ApplySleepAddScore)
	JumpIfHasMoveWithEffect(attacker, move_ef.wake-up_slap, &Label_ApplySleepAddScore)
	JumpIfHasMoveWithEffect(defender, move_ef.sleep_talk, &Label_SleepReduceScore)
	JumpIfHasMoveWithEffect(defender, move_ef.magic_coat, &Label_ApplySleepRandomReduceScore)
	JumpIfHasMoveWithEffect(defender, move_ef.snore, &Label_ApplySleepRandomReduceScore)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.no_guard, &Label_ApplySleepAddScore)
	JumpIfStoredEQ(ability.shed_skin, &Label_ApplySleepRandomReduceScore)
	Jump(&endScript_2)

Label_SleepReduceScore:
	AddToScore(-1)

Label_ApplySleepRandomReduceScore:
	JumpIfRandLT(128, &endScript_2)
	AddToScore(-1)
	Jump(&endScript_2)

Label_ApplySleepAddScore:
	JumpIfRandLT(128, &endScript_2)
	AddToScore(1)

endScript_2:
	EndScript()

















//   DAMAGE ABSORB   

Label_DmgAbsorb:
	JumpIfEffectivenessEQ(0x, &Label_DmgAbsorbHighChanceToReduce)
	JumpIfEffectivenessEQ(1/2x, &Label_DmgAbsorbHighChanceToReduce)
	JumpIfEffectivenessEQ(1/4x, &Label_DmgAbsorbHighChanceToReduce)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.liquid_ooze, &Label_DmgAbsorbHighChanceToReduce)
	Jump(&endScript_3)

Label_DmgAbsorbHighChanceToReduce:
	JumpIfRandLT(50, &endScript_3)
	AddToScore(-3)

endScript_3:
	EndScript()













//   EXPLOSION   
Label_Explosion:
    // THIS LOGIC SHOULD ENDURE THAT THE AI NEVER EXPLODES AT MAX HEALTH
    JumpIfHealthLT(attacker, 100, &Label_ExplosionStart)
    AddToScore(-3)

Label_ExplosionStart:
	JumpIfStatStageLT(defender, eva, +1, &ExplosionCheck1)
	AddToScore(-1)
	JumpIfStatStageLT(defender, eva, +4, &ExplosionCheck1)
	JumpIfRandLT(128, &ExplosionCheck1)
	AddToScore(-1)

ExplosionCheck1:
	JumpIfHealthLT(attacker, 80, &ExplosionCheck2)
	JumpCompareSpeed(GT, &ExplosionCheck2)
	JumpIfRandSeedLT(50, &endScript_4)
	Jump(&deprioritizeBy3)

ExplosionCheck2:
	JumpIfHealthGT(attacker, 50, &ExplosionCheck4)
	JumpIfRandSeedGT(128, &ExplosionCheck3)
	AddToScore(1)

ExplosionCheck3:
	JumpIfHealthGT(attacker, 30, &endScript_4)
	JumpIfRandSeedGT(128, &endScript_4)
	AddToScore(1)
	Jump(&endScript_4)

ExplosionCheck4:
	JumpIfRandSeedLT(50, &endScript_4)
	AddToScore(-1)

endScript_4:
	EndScript()










//   RAISE USER ATTACK   

Label_RaiseUserAttack:
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.unaware, &address_0x08FE)
	JumpIfStatStageLT(attacker, atk, +3, &address_0x08AC)
	JumpIfRandLT(100, &address_0x08D8)
	AddToScore(-1)
	Jump(&address_0x08D8)

address_0x08AC:
	JumpIfHealthNE(attacker, 100, &address_0x08D8)
	JumpIfHasMoveWithEffect(attacker, move_ef.baton_pass, &address_0x08D2)
	JumpIfRandLT(128, &address_0x08D8)

address_0x08D2:
	AddToScore(2)

address_0x08D8:
	JumpIfHealthGT(attacker, 70, &address_0x0904)
	JumpIfHealthLT(attacker, 40, &address_0x08FE)
	JumpIfRandLT(40, &address_0x0904)

address_0x08FE:
	AddToScore(-2)

address_0x0904:
	EndScript()


















//   RAISE USER DEFENSE   

Label_RaiseUserDefense:
    GetLastPreviousCategory()
	JumpIfStoredEQ(special, &Label_RaiseDefense_DeprioritizeBy5)
	GetAbilityGuess(defender)
	JumpIfStoredEQ(ability.unaware, &Label_RaiseDefense_DeprioritizeBy5)
	JumpIfStatStageLT(attacker, def, +3, &address_0x092E)
	JumpIfRandLT(100, &address_0x0954)
	AddToScore(-1)
	Jump(&address_0x0954)

address_0x092E:
	JumpIfHealthNE(attacker, 100, &address_0x095A)
	JumpIfHasMoveWithEffect(attacker, move_ef.baton_pass, &address_0x0954)
	JumpIfRandLT(128, &address_0x095A)

address_0x0954:
	AddToScore(2)

address_0x095A:
	JumpIfHealthLT(attacker, 70, &address_0x0972)
	JumpIfRandLT(200, &address_0x09B8)

address_0x0972:
	JumpIfHealthLT(attacker, 40, &Label_RaiseDefense_DeprioritizeBy5)
	JumpIfRandLT(60, &address_0x09B8)

address_0x09A8:
	JumpIfRandLT(60, &address_0x09B8)

Label_RaiseDefense_DeprioritizeBy5:
	AddToScore(-5)

address_0x09B8:
	EndScript()







//   RAISE USER SPEED   

Label_Automatize:
	JumpIfHasNoMovesWithEffect(defender, move_ef.low_kick, &Label_RaiseUserSpeed)
	JumpIfRandLT(60, &Label_RaiseUserSpeed)
	AddToScore(1)

Label_RaiseUserSpeed:
	JumpCompareSpeed(GT, &address_0x09EE)
	AddToScore(-3)
	Jump(&address_0x0AA0)

address_0x09EE:
	JumpIfHasMoveWithEffect(attacker, move_ef.dmg_flinch, &address_0x0A80)
	JumpIfHasMoveWithEffect(attacker, move_ef.heal_50, &address_0x0A80)
	JumpIfHasMoveWithEffect(attacker, move_ef.rest, &address_0x0A80)
	JumpIfHasMoveWithEffect(attacker, move_ef.morning_sun, &address_0x0A80)
	JumpIfHasMoveWithEffect(attacker, move_ef.roost, &address_0x0A80)
