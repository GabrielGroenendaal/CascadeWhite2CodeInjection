//   CHARGE MOVES   

Label_ChargeMoves:
	JumpIfEffectivenessEQ(0x, &chargeMoves_ReduceScoreBy2)
	JumpIfEffectivenessEQ(1/4x, &chargeMoves_ReduceScoreBy2)
	JumpIfEffectivenessEQ(1/2x, &chargeMoves_ReduceScoreBy2)
	JumpIfMoveEffectEQ(move_ef.solar_beam, &address_SolarBeamCheck)
	JumpIfMoveEffectEQ(move_ef.sky_attack, &address_StatBoostingChargeMoves)
	JumpIfMoveEffectEQ(move_ef.ice_burn, &address_ElectroShotCheck)
	JumpIfMoveEffectEQ(move_ef.skull_bash, &address_StatBoostingChargeMoves)
	Jump(&chargeMoves_PowerHerbCheck)

address_SolarBeamCheck:
	GetWeather()
	JumpIfStoredNE(weather.sun, &chargeMoves_PowerHerbCheck)
	Jump(&endScript_ChargeMoves)

address_ElectroShotCheck:
	GetWeather()
	JumpIfStoredNE(weather.rain, &chargeMoves_PowerHerbCheck)
	Jump(&endScript_ChargeMoves)

chargeMoves_PowerHerbCheck:
	JumpIfHeldItemEQ(attacker, item.power_herb, &endScript_ChargeMoves)
	Jump(&chargeMoves_ChanceToReduceScore)

address_StatBoostingChargeMoves:
	JumpIfHeldItemEQ(attacker, item.power_herb, &endScript_ChargeMoves)
	JumpIfUserWillFaint_Setup(&chargeMoves_ReduceScoreBy12)
	JumpIfUserWillTakeLowDamage_Setup(&chargeMoves_HighChanceToRaiseScoreBy2)
	Jump(&endScript_ChargeMoves)

chargeMoves_HighChanceToRaiseScoreBy2:
	JumpIfRandLT(60, &endScript_ChargeMoves)
	AddToScore(2)
	Jump(&endScript_ChargeMoves)

chargeMoves_ChanceToReduceScore:
	JumpIfHasMoveWithEffect(defender, move_ef.protect, &chargeMoves_ReduceScoreBy2)
	JumpIfHealthGT(attacker, 38, &endScript_ChargeMoves)
	AddToScore(-1)
	Jump(&endScript_ChargeMoves)

chargeMoves_ReduceScoreBy2:
	AddToScore(-2)
	Jump(&endScript_ChargeMoves)

chargeMoves_ReduceScoreBy12:
	AddToScore(-12)

endScript_ChargeMoves:
	EndScript()














