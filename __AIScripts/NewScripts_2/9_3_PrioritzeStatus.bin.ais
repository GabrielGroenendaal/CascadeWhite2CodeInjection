	JumpIfTargetIsAlly(&address_0x002E)
	GetTurnCount()
	JumpIfStoredNE(0, &address_0x002E)
	GetMoveEffect()
	JumpIfStoredIsNotInList(&data_address_0x0030, &address_0x002E)
	JumpIfRandLT(80, &address_0x002E)
	AddToScore(2)

address_0x002E:
	EndScript()


data_address_0x0030:
